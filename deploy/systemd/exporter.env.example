# Optional production overrides.
# Keep the installed file /etc/stellar-data-exporter/exporter.env mode 0600.
#
# The application protects every UI/API route except /api/health with HTTP Basic Auth.
# Defaults requested for the development deployment:
#   username: stellar
#   password: stellar
# Override both values before exposing an Internet-reachable production deployment:
# STELLAR_EXPORTER_UI_USERNAME=<username>
# STELLAR_EXPORTER_UI_PASSWORD=<strong-password>
#
# Set STELLAR_EXPORTER_UI_AUTH_DISABLED=1 only for isolated test automation.
#
# Prefer leaving STELLAR_EXPORTER_SCHEDULE_KEY unset so the service-owned
# /var/lib/stellar-data-exporter/schedule.key is generated once with mode 0600.
# It encrypts scheduled export payloads and the optional saved Stellar Cyber connection.
# To inject a managed Fernet key instead, uncomment:
# STELLAR_EXPORTER_SCHEDULE_KEY=<FERNET-KEY>
#
# Optional custom poll cadence:
# STELLAR_EXPORTER_SCHEDULE_POLL_SECONDS=30
#
# Optional large-export confirmation thresholds:
# STELLAR_EXPORTER_LARGE_EXPORT_WARNING_RECORDS=100000
# STELLAR_EXPORTER_LARGE_EXPORT_CRITICAL_RECORDS=1000000
