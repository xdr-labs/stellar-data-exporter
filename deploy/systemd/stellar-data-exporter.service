[Unit]
Description=Stellar Data Exporter
Documentation=file:/opt/stellar-data-exporter/docs/PRODUCTION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stellar-exporter
Group=stellar-exporter
WorkingDirectory=/opt/stellar-data-exporter
Environment=PYTHONUNBUFFERED=1
Environment=STELLAR_EXPORTER_JOB_DB=/var/lib/stellar-data-exporter/export-jobs.sqlite3
Environment=STELLAR_EXPORTER_SCHEDULE_DB=/var/lib/stellar-data-exporter/export-schedules.sqlite3
Environment=STELLAR_EXPORTER_SCHEDULE_KEY_FILE=/var/lib/stellar-data-exporter/schedule.key
Environment=STELLAR_EXPORTER_SCHEDULE_POLL_SECONDS=30
EnvironmentFile=-/etc/stellar-data-exporter/exporter.env
ExecStart=/opt/stellar-data-exporter/.venv/bin/stellar-data-exporter --host 127.0.0.1 --port 8787 --no-tls --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
StateDirectory=stellar-data-exporter
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
